# Neon pooled connection used by the running application
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require&pgbouncer=true"
# Neon direct connection used only by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-at-least-32-random-characters"
PORT=3000
CORS_ORIGINS="http://localhost:5173,http://localhost:3001"
NODE_ENV="development"
SWAGGER_ENABLED=true
